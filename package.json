{
  "name": "curiosity-travel-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"node --import tsx --watch server/index.ts\" \"next dev --hostname 0.0.0.0\"",
    "build": "next build --webpack",
    "start": "concurrently -k \"node --import tsx server/index.ts\" \"next start --hostname 0.0.0.0\"",
    "db:setup": "node --import tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx scripts/integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jspdf": "4.2.1",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.6.0",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
